  "<15K",
  "15K-45K",
  "45K-98K",
  "98K-262K"
 ],
 "_metric_keys": {
  "ap": "auPRC (average_precision_score) \u2014 the bar height",
  "auc": "AUROC",
  "sites": "pairs scored in the bin",
  "pos": "positives in the bin",
  "ap_lo/ap_hi": "2.5th / 97.5th percentile of 1,000 bootstrap resamples",
  "tss_ap/tss_auc": "the model-free 1/distance baseline on the SAME pairs \u2014 depends only on the pair table, so it validates the cohort reconstruction with no GPU"
 },
